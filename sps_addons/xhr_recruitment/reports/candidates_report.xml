<odoo>
    <record model="ir.ui.view" id="recruitment_candidates_report_view_tree">
        <field name="name">Candidate Report</field>
        <field name="model">recruitment.candidate.report</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false" default_order="id asc">
                <field name="name"/>
                <field name="total"/>
                <field name="apply"/>
                <field name="reject"/>
                <field name="interview_pass"/>
                <field name="interview_fail"/>
                <field name="archived"/>
                <field name="reject_job"/>
                <field name="pending"/>
                <field name="approved"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="report_recruitment_candidates_act">
        <field name="name">Candidate Report</field>
        <field name="res_model">recruitment.candidate.report</field>
        <field name="view_mode">tree</field>
        <field name="limit">20</field>
    </record>

    <menuitem
            id="report_recruitment_candidates_menu"
            name="Tổng hợp ứng viên cần lưu tâm"
            action="report_recruitment_candidates_act"
            parent="hr_recruitment.report_hr_recruitment"
            sequence="3"/>
</odoo>
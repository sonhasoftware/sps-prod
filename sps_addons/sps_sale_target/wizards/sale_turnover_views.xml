<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_turnover_wiz_view_form" model="ir.ui.view">
        <field name="name">sale.turnover.wiz.view.form</field>
        <field name="model">sale.turnover.wiz</field>
        <field name="arch" type="xml">
            <form string="Sale Turnover">
                <sheet>
                    <group name="year" string="Report Year">
                        <field name="report_year" />
                    </group>
                </sheet>
                <footer>
                    <button string="Ok" name="ok" type="object" class="oe_highlight" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="sale_turnover_wiz_action" model="ir.actions.act_window">
        <field name="name">Sales Turnover Report</field>
        <field name="res_model">sale.turnover.wiz</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sps_sale_target.sale_turnover_wiz_view_form" />
        <field name="target">new</field>
    </record>

    <menuitem
        id="sale_turnover_wiz_menu"
        name="Sales Turnover Report"
        action="sale_turnover_wiz_action"
        groups="sales_team.group_sale_salesman"
        parent="sale.menu_sale_report"
        sequence="100"/>

</odoo>

<?xml version="1.0" ?>
<odoo>
    <data noupdate="1">

        <record id="sequence_name_sale_order" model="ir.sequence">
            <field name="name">sequence_name_sale_order</field>
            <field name="code">SEQ_NAME_SALE_ORDER</field>
            <field name="prefix">New</field>
            <field name="padding">2</field>
            <field name="company_id" eval="False"/>
            <field name="use_date_range" eval="True" />
        </record>

        <record id="add_date_range_one_day" model="ir.sequence.date_range">
            <field name="sequence_id" eval="ref('sps_sale_target.sequence_name_sale_order')"/>
            <field name="date_from">2020-01-01</field>
            <field name="date_to">2020-01-02</field>
            <field name="number_next_actual">1</field>
        </record>

        <!-- <record id="increment_sale_project_line_sq" model="ir.sequence">
            <field name="name">Sale Project Line Incrementation</field>
            <field name="code">increment_estimate_sq</field>
            <field name="prefix"></field>
            <field name="company_id" eval="False"/>
        </record> -->

    </data>
</odoo>

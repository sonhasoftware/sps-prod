<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_quotation_boq_xlsx" model="ir.actions.server">
        <field name="name">Quotation / Order: Quotation Details (Excel)</field>
        <field name="binding_model_id" ref="model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="model_id" ref="model_sale_order"/>
        <field name="state">code</field>
        <field name="code">
            if records:
            action = records.action_report_quotation_xlsx('boq')
        </field>
    </record>

    <record id="action_report_quotation_cover_xlsx" model="ir.actions.server">
        <field name="name">Quotation / Order: Cover (Excel)</field>
        <field name="binding_model_id" ref="model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="model_id" ref="model_sale_order"/>
        <field name="state">code</field>
        <field name="code">
            if records:
            action = records.action_report_quotation_xlsx('cover')
        </field>
    </record>

    <record id="action_report_quotation_est_xlsx" model="ir.actions.server">
        <field name="name">Quotation / Order: Estimate (Excel)</field>
        <field name="binding_model_id" ref="model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="model_id" ref="model_sale_order"/>
        <field name="state">code</field>
        <field name="code">
            if records:
            action = records.action_report_quotation_xlsx('est')
        </field>
    </record>
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="name">Quotation / Order</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale.report_saleorder</field>
        <field name="report_file">sale.report_saleorder</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.name)) or
            'Order - %s' % (object.name)
        </field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>

    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_quotation_tree" model="ir.ui.view">
        <field name="name">sale_order_quotation_tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="partner_id" position="move"/>
                <field name="x_investor_id" optional="hide"/>
                <field name="x_partner_ref"/>
                <field name="work_content"/>
                <field name="request_partner_id"/>
                <field name="location_partner_id"/>
                <field name="project_type"/>
                <field name="date_order"/>
                <field name="validity_date"/>
                <field name="state" position="move"/>
                <field name="user_id" position="move"/>
                <field name="solution_maker"/>
            </field>
            <field name="create_date" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="activity_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="amount_total" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="view_order_tree" model="ir.ui.view">
        <field name="name">sale_order_tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="partner_id" position="move"/>
                <field name="x_partner_ref"/>
                <field name="work_content"/>
                <field name="request_partner_id"/>
                <field name="location_partner_id"/>
                <field name="project_type"/>
                <field name="date_order" position="move"/>
                <field name="validity_date"/>
                <field name="state" position="move"/>
                <field name="user_id" position="move"/>
                <field name="solution_maker"/>
            </field>
            <field name="date_order" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <field name="activity_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="amount_total" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="invoice_status" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="sale_order_inherit_view_form" model="ir.ui.view">
        <field name="name">sale_order_inherit_view_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']" position='after'>
                <div>
                    <h2>
                        <label for="name" string="Số báo giá"/>
                        <field name="name"/>
                    </h2>
                </div>
            </xpath>

            <xpath expr="//div[@class='oe_title']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//form" position='attributes'>
                <attribute name="class">x_sale_order</attribute>
            </xpath>
            <xpath expr="//field[@name='state'][1]" position='attributes'>
                <attribute name="statusbar_visible">draft,sale</attribute>
            </xpath>
            <xpath expr="//button[@name='action_quotation_send'][1]" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_quotation_send'][2]" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_quotation_send'][3]" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_quotation_send'][4]" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][2]" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position='attributes'>
                <attribute name="attrs">{'invisible': ['|', ('state', 'not in', ['sent','sale']), ('id', '=', False)]}
                </attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][2]" position='before'>
                <button name="action_mark_sent" string="Gửi duyệt" type="object"
                        attrs="{'invisible': [('state', 'not in', ['draft'])]}"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="context">{'res_partner_search_mode': 'customer', 'show_vat': True}</attribute>
                <attribute name="domain">[('parent_id', '=', False)]</attribute>
            </xpath>
            <xpath expr="//label[@for='pricelist_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='pricelist_id']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='update_prices']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='team_id']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='require_signature']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='require_payment']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='fiscal_position_id']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='analytic_account_id']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='campaign_id']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='medium_id']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='source_id']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='commitment_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='commitment_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//create[@name='add_note_control']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//create[@name='add_note_control']" position="attributes">
                <attribute name="string">Add a section</attribute>
            </xpath>
            <xpath expr="//div[@class='o_td_label'][1]" position='before'>
                <field name="x_inquiry_date"/>
            </xpath>
            <xpath expr="//field[@name='date_order'][2]" position='after'>
                <field name="validity_date" position="move"/>
            </xpath>
            <xpath expr="//field[@name='date_order'][1]" position='attributes'>
                 <attribute name="groups">base.group_user</attribute>
                 <attribute name="attrs">{'readonly': [(0, '=', 1)],'invisible': [('state', 'in', ['sale', 'done', 'cancel'])]}</attribute>
            </xpath>
            <xpath expr="//field[@name='date_order'][2]" position='attributes'>
                 <attribute name="attrs">{'readonly': [(0, '=', 1)],'required': [('state', 'in', ['sale', 'done'])], 'invisible': [('state', 'in', ['draft', 'sent'])]}</attribute>
            </xpath>
            <xpath expr="//div[@class='o_td_label'][1]" position='attributes'>
                 <attribute name="groups">base.group_user</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position='after'>
                <field name="x_investor_id" domain="[('parent_id', '=', False)]" string="Chủ đầu tư"/>
                <field name="request_partner_id" context="{'default_type': 'contact', 'xx_parent_id': partner_id}"
                       domain="[('parent_id', '=', partner_id), ('type', '=', 'contact')]"/>
                <field name="work_content"/>
                <field name="location_partner_id"
                       domain="[('parent_id', '=', partner_id), ('type', '=', 'delivery')]"
                       widget="res_partner_many2one"
                       context="{'show_address': 1, 'default_type': 'delivery', 'xx_parent_id': partner_id}"/>
                <field name="work_scope"/>
                <field name="work_note"/>
                <field name="x_expertise_ids" widget="many2many_tags"/>
                <field name="count_project_line" invisible="1"/>
            </xpath>
            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="project_type"/>
                <field name="r_maintenace"
                attrs="{'invisible': [('project_type', 'not in', ['maintainance'])]}"/>
                <field name="e_fm"
                attrs="{'invisible': [('project_type', 'not in', ['operation'])]}"/>
                <field name="x_gen_cost_percent"/>
                <field name="x_gen_cost_tax_id"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position='replace'>
            </xpath>
            <xpath expr="//page[@name='other_information']//group[@name='sales_person']//field[@name='user_id']"
                   position="attributes">
                <attribute name="string">Key Account</attribute>
            </xpath>
            <xpath expr="//page[@name='other_information']//group[@name='sales_person']//field[@name='user_id']"
                   position="after">
                <field name="solution_maker"/>
                <label for="prepare_time"/>
                <div>
                    <field name="prepare_time" class="oe_inline"/>
                    <field name="prepare_time_unit" class="oe_inline"/>
                </div>
                <label for="work_time"/>
                <div>
                    <field name="work_time" class="oe_inline"/>
                    <field name="work_time_unit" class="oe_inline"/>
                </div>
                <label for="x_warranty_period"/>
                <div>
                    <field name="x_warranty_period" class="oe_inline"/>
                    <field name="x_warranty_period_unit" class="oe_inline"/>
                </div>
                <field name="x_date_warranty_expire"/>
            </xpath>
            <xpath expr="//page[@name='other_information']//group[@name='sale_info']//field[@name='fiscal_position_id']"
                   position="before">
                <field name="payment_term_id" options="{'no_open':True,'no_create': True}"/>
                <field name="order_note"/>
                <field name="x_amount_estimate"/>
                <field name="cr"/>
                <field name="tp"/>
                <field name="overhead_cost"/>
                <field name="cr_amount" readonly="1"/>
                <field name="tp_amount" readonly="1"/>
                <field name="overhead_cost_amount" readonly="1"/>
                <field name="profit_formula_id" options="{'no_create': True}"/>
                <field name="income_tax" readonly="1"/>
                <field name="profit_after_tax" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="after">
                <field name="parent_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']"
                   position="attributes">
                <attribute name="attrs">{'readonly': [(1, '=', 1)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']"
                   position="attributes">
                <attribute name="attrs">{'readonly': [(1, '=', 1)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='tax_id']" position="attributes">
                <attribute name="attrs"></attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="before">
                <page string="Estimates" name="estimates">
                    <field name="sale_estimates_line_ids" class="estimates_line"
                           context="{'x_count_project_line': count_project_line}"
                           attrs="{'readonly': [('state', 'in', ('done', 'cancel'))]}">
                        <tree string="Estimates Line" editable="bottom">
                            <field name="type" invisible="1"/>
                            <field name="product_tmpl_id" invisible="1"/>
                            <control>
                                <create name="add_quote_control" string="Add a quote"
                                        context="{'default_type': 'quote'}"/>
                                <create name="add_estimate_control" string="Add a estimate"
                                        context="{'default_type': 'estimate'}"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field name="order_line_id"
                                   attrs="{'readonly': [(1, '=', 1)]}"/>
                            <field name="product_id"
                                   attrs="{'required': [(1, '=', 1)]}"/>
                            <field name="category"/>
                            <field name="uom_id"/>
                            <field name="qty"/><!-- attrs="{'readonly': [('type', '=', 'quote'), ('parent.project_type', '!=', 'service')], 'required': [('type', '=', 'estimate')]}"/> -->
                            <field name="materials_price_unit" string="Material Price"
                                   attrs="{'readonly': [('type', '=', 'quote'), ('parent.project_type', '!=', 'service')]}"/>
                            <field name="worker_price_unit" string="Worker Price"
                                   attrs="{'readonly': [('type', '=', 'quote'), ('parent.project_type', '!=', 'service')]}"/>
                            <field name="other_price_unit" string="Other Price"
                                   attrs="{'readonly': [('type', '=', 'quote'), ('parent.project_type', '!=', 'service')]}"/>
                            <field name="total_price_unit" optional="show"/>
                            <field name="timeline" optional="show"
                                   attrs="{'readonly': [('type', '=', 'quote'), ('parent.project_type', '!=', 'service')]}"/>
                            <field name="predicted_price" force_save="1" optional="show"/>
                            <field name="markup_materials" string="Material(%s)" optional="show"
                                   attrs="{'readonly': [('type', '=', 'quote'), ('parent.project_type', '!=', 'service')]}"/>
                            <field name="markup_worker" string="Worker(%)" optional="show"
                                   attrs="{'readonly': [('type', '=', 'quote'), ('parent.project_type', '!=', 'service')]}"/>
                            <field name="markup_other" string="Other(%)" optional="show"
                                   attrs="{'readonly': [('type', '=', 'quote'), ('parent.project_type', '!=', 'service')]}"/>
                            <field name="retail_price_unit" force_save="1" optional="show"/>
                            <field name="note" optional="show"/>
                            <field name="sale_order_project_type" invisible="1"/>
                        </tree>
                    </field>

                </page>
            </xpath>
            <xpath expr="//group[@name='sale_shipping']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='action_confirm'][1]" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][2]" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
            </xpath>

            <field name="amount_untaxed" position="before">
                <field name="x_gen_cost" widget="monetary" readonly="1" force_save="1"
                       options="{'currency_field': 'currency_id'}"/>
            </field>

        </field>
    </record>

    <record id="sale_management_inherit_view_form" model="ir.ui.view">
        <field name="name">sale_management_inherit_view_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='optional_products']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>

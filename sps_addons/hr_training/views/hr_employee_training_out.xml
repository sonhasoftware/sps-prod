<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="view_hr_employee_training_out_tree" model="ir.ui.view">
            <field name="name">hr.employee.training.out.tree</field>
            <field name="model">hr.employee.training.out</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="job_title"/>
                    <field name="phone"/>
                    <field name="email"/>
                </tree>
            </field>
        </record>

        <record id="view_hr_employee_training_out_form" model="ir.ui.view">
            <field name="name">hr.employee.training.out.form</field>
            <field name="model">hr.employee.training.out</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="job_title"/>
                            </group>
                            <group>
                                <field name="phone" widget="phone"/>
                                <field name="email" widget="email"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_employee_training_out_search_view" model="ir.ui.view">
            <field name="name">hr.employee.training.out.search</field>
            <field name="model">hr.employee.training.out</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="hr_employee_training_out_act_window" model="ir.actions.act_window">
            <field name="name">Người đào tạo bên ngoài</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.employee.training.out</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem name="Người đào tạo bên ngoài" id="hr_employee_training_out_ds_sfmenu"
                  parent="hr.menu_human_resources_configuration" action="hr_employee_training_out_act_window"
                  sequence="20"/>

    </data>
</odoo>

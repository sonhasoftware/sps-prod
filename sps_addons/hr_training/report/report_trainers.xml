<odoo>
    <record id="report_trainers" model="ir.ui.view">
        <field name="name">report.trainers</field>
        <field name="model">report.trainers</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false" edit="false" sample="1">
                <field name="id" string="No"/>
                <field name="trainer"/>
                <field name="m1"/>
                <field name="m2"/>
                <field name="m3"/>
                <field name="m4"/>
                <field name="m5"/>
                <field name="m6"/>
                <field name="m7"/>
                <field name="m8"/>
                <field name="m9"/>
                <field name="m10"/>
                <field name="m11"/>
                <field name="m12"/>
                <field name="total"/>
                <field name="ratio" string="Result up >= 75%"/>
            </tree>
        </field>
    </record>

    <record id="action_report_hr_training_trainers" model="ir.actions.act_window">
        <field name="name">Trainers</field>
        <field name="res_model">report.trainers</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
            id="menu_report_hr_training_trainers"
            name="Trainers"
            action="action_training_trainers_report_wizard"
            parent="menu_report_training_root"
            sequence="7"/>
</odoo>
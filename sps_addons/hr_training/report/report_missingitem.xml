<odoo>
    <record model="ir.ui.view" id="report_missing_item_view">
        <field name="name">Missing Item</field>
        <field name="model">report.missing.item</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false">
                <field name="name" string="Full name"/>
                <field name="x_code" string="Code"/>
                <field name="job_title" string="Position"/>
                <field name="basic_item" string="Basic training"/>
                <field name="item_done" string="Items done"/>
                <field name="missing_item" string="Missing items"/>
            </tree>
        </field>
    </record>

    <record id="report_missing_item_act" model="ir.actions.act_window">
        <field name="name">Missing Item</field>
        <field name="res_model">report.missing.item</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem
            id="menu_report_missing_item"
            name="Missing Item"
            action="report_missing_item_act"
            parent="menu_report_training_root"
            sequence="9"/>
</odoo>
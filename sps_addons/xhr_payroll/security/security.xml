<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="xhr_user_work_entry_all" model="ir.rule">
            <field name="name">Work entries: self and subordinates</field>
            <field name="model_id" ref="hr_work_entry.model_hr_work_entry"/>
            <field name="domain_force">['|', '|', ('employee_id.user_id', '=', user.id), ('employee_id.department_id.manager_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_read" eval="1"/>
        </record>

        <record id="xhr_user_work_entry_official" model="ir.rule">
            <field name="name">Work entries: HR Official</field>
            <field name="model_id" ref="hr_work_entry.model_hr_work_entry"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_read" eval="1"/>
        </record>
    </data>
    <data noupdate="1">

        <record id="xhr_contract_all" model="ir.rule">
            <field name="name">Contract: only self</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_read" eval="1"/>
        </record>

        <record id="xhr_contract_official" model="ir.rule">
            <field name="name">Contract: HR Official</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_read" eval="1"/>
        </record>
    </data>

</odoo>

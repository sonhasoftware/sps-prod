<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Work shift config -->
    <data>
        <record id="view_hr_work_shift_config_tree" model="ir.ui.view">
            <field name="name">hr.work.shift.config.tree</field>
            <field name="model">hr.work.shift.config</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="is_leave"/>
<!--                    <field name="is_leave_global"/>-->
                    <field name="company_id" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <record id="view_hr_work_shift_config_form" model="ir.ui.view">
            <field name="name">hr.work.shift.config.form</field>
            <field name="model">hr.work.shift.config</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="is_leave"/>
<!--                                <field name="is_leave_global"/>-->
                            </group>
                        </group>
                        <group attrs="{'invisible': [('is_leave', '=', True)]}">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="time_from" widget="float_time"/>
                                    <field name="time_to" widget="float_time"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="time_from" widget="float_time"/>
                                        <field name="time_to" widget="float_time"/>
                                    </group>
                                </form>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_work_shift_config" model="ir.actions.act_window">
            <field name="name">Work Shift Config</field>
            <field name="res_model">hr.work.shift.config</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
        </record>

        <menuitem
            id="menu_hr_work_shift_config"
            name="Work Shift Config"
            action="action_hr_work_shift_config"
            parent="menu_hr_work_shift_settings"
            sequence="1"/>

    </data>


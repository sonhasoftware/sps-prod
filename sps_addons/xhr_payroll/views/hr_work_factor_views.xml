<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_work_factor_tree" model="ir.ui.view">
            <field name="name">hr.work.factor.tree</field>
            <field name="model">hr.work.factor</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="type_day"/>
                    <field name="type_time"/>
                    <field name="shift"/>
                    <field name="has_ot"/>
                    <field name="percent"/>
                    <field name="note"/>
                </tree>
            </field>
        </record>

        <record id="view_hr_work_factor_form" model="ir.ui.view">
            <field name="name">hr.work.factor.form</field>
            <field name="model">hr.work.factor</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <label for="name"/>
                        <field name="name" required="1"/>
                        <group>
                            <group>
                                <field name="type_day"/>
                                <field name="type_time"/>
                            </group>
                            <group>
                                <field name="shift" widget="radio" options="{'horizontal': true}"/>
                                <field name="has_ot" widget="boolean_toggle"/>
                                <field name="percent"/>
                            </group>
                        </group>
                        <label for="note"/>
                        <field name="note"/>

                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_hr_work_factor" model="ir.actions.act_window">
            <field name="name">Work factor</field>
            <field name="res_model">hr.work.factor</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
        </record>

        <menuitem
            id="menu_hr_work_factor"
            name="Work factor"
            action="action_hr_work_factor"
            parent="menu_hr_work_shift_settings"
            sequence="10"/>

    </data>

</odoo>

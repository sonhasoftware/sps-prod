<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_recruitment_efficiency_wizards" model="ir.ui.view">
            <field name="name">Báo cáo hiệu quả tuyển dụng</field>
            <field name="model">recruitment.efficiency.wizards</field>
            <field name="arch" type="xml">
                <form string="Báo cáo hiệu quả tuyển dụng">
                    <group>
                        <field name="year"/>
                    </group>
                    <footer>
                        <button name="action_report" string="Xem báo cáo" type="object" class="btn-primary"/>
                        <button string="Đóng" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_recruitment_efficiency_wizards" model="ir.actions.act_window">
            <field name="name">Báo cáo hiệu quả tuyển dụng</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">recruitment.efficiency.wizards</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <menuitem id="recruitment_efficiency_menu"
                  name="Báo cáo hiệu quả tuyển dụng"
                  action="action_recruitment_efficiency_wizards"
                  parent="effective_management.effective_hr"
                  sequence="2"
        />
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_tracking_supplier_wizards" model="ir.ui.view">
            <field name="name">Báo cáo theo dõi NCC</field>
            <field name="model">purchase.tracking.supplier.wizards</field>
            <field name="arch" type="xml">
                <form string="Báo cáo tình trạng giao hàng">
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <footer>
                        <button name="action_report" string="Xem báo cáo" type="object" class="btn-primary"/>
                        <button string="Đóng" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_purchase_tracking_supplier_wizards" model="ir.actions.act_window">
            <field name="name">Báo cáo theo dõi nhà cung cấp</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.tracking.supplier.wizards</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <menuitem id="purchase_tracking_supplier_menu"
                  name="Báo cáo theo dõi nhà cung cấp"
                  action="action_purchase_tracking_supplier_wizards"
                  parent="effective_management.effective_purchase"
                  sequence="6"
        />
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_project_efficiency_coefficient_wizards" model="ir.ui.view">
            <field name="name">Báo cáo hiệu xuất lao động</field>
            <field name="model">project.efficiency.coefficient.wizards</field>
            <field name="arch" type="xml">
                <form string="Báo cáo hiệu quả sử dụng ngân sách ngoài nhân công">
                    <group>
                        <field name="year"/>
                    </group>
                    <footer>
                        <button name="action_report" string="Xem báo cáo" type="object" class="btn-primary"/>
                        <button string="Đóng" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_project_efficiency_coefficient_wizards" model="ir.actions.act_window">
            <field name="name">Báo cáo hiệu suất lao động</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.efficiency.coefficient.wizards</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <menuitem id="project_efficiency_coefficient_menu"
                  name="Báo cáo hiệu suất lao động"
                  action="action_project_efficiency_coefficient_wizards"
                  parent="effective_management.effective_project"
                  sequence="1"
        />
    </data>
</odoo>
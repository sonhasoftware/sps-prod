<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_project_reward_detail_wizards" model="ir.ui.view">
            <field name="name">Bảng thống kê chi tiết thưởng</field>
            <field name="model">project.reward.detail.wizards</field>
            <field name="arch" type="xml">
                <form string="Bảng thống kê chi tiết thưởng">
                    <group>
                        <field name="year"/>
                    </group>
                    <footer>
                        <button name="action_report" string="Xem báo cáo" type="object" class="btn-primary"/>
                        <button string="Đóng" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_project_reward_detail_wizards" model="ir.actions.act_window">
            <field name="name">Bảng thống kê chi tiết thưởng</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.reward.detail.wizards</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="project_reward_detail_menu"
                  name="Bảng thống kê chi tiết thưởng"
                  action="action_project_reward_detail_wizards"
                  parent="effective_management.effective_project"
                  sequence="6"
        />
    </data>
</odoo>

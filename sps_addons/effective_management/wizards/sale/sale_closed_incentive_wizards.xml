<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_closed_incentive_wizards" model="ir.ui.view">
            <field name="name">Thống kê báo giá đã hoàn thành</field>
            <field name="model">sale.closed.incentive.wizards</field>
            <field name="arch" type="xml">
                <form string="Thống kê báo giá đã hoàn thành">
                    <group>
                        <field name="year"/>
                    </group>
                    <footer>
                        <button name="action_report" string="Xem báo cáo" type="object" class="btn-primary"/>
                        <button string="Đóng" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sale_closed_incentive_wizards" model="ir.actions.act_window">
            <field name="name">Thống kê báo giá đã hoàn thành</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sale.closed.incentive.wizards</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <menuitem id="sale_closed_incentive_menu"
                  name="Báo cáo thống kê báo giá đã hoàn thành"
                  action="action_sale_closed_incentive_wizards"
                  parent="effective_management.effective_sale"
                  sequence="7"
        />
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sale_annual_wizards" model="ir.ui.view">
            <field name="name">Báo cáo doanh số năm</field>
            <field name="model">sale.annual.wizards</field>
            <field name="arch" type="xml">
                <form string="Báo cáo tình trạng giao hàng">
                    <group>
                        <field name="year" required="True"/>
                    </group>
                    <footer>
                        <button name="action_report" string="Xem báo cáo" type="object" class="btn-primary"/>
                        <button string="Đóng" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sale_annual_wizards" model="ir.actions.act_window">
            <field name="name">Báo cáo doanh số năm</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sale.annual.wizards</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <menuitem id="sale_annual_menu"
                  name="Báo cáo doanh số năm"
                  action="action_sale_annual_wizards"
                  parent="effective_management.effective_sale"
                  sequence="8"
        />
    </data>
</odoo>
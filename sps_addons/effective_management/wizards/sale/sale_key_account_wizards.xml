<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sale_key_account_wizards" model="ir.ui.view">
            <field name="name">Báo cáo khách hàng có hợp đồng</field>
            <field name="model">sale.key.account.wizards</field>
            <field name="arch" type="xml">
                <form string="Báo cáo khách hàng có hợp đồng">
                    <group>
                        <field name="year"/>
                    </group>
                    <footer>
                        <button name="action_report" string="Xem báo cáo" type="object" class="btn-primary"/>
                        <button string="Đóng" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sale_key_account_wizards" model="ir.actions.act_window">
            <field name="name">Báo cáo doanh số theo NVPT</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sale.key.account.wizards</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <menuitem id="purchase_sale_key_account_menu"
                  name="Báo cáo doanh số theo NVPT"
                  action="action_sale_key_account_wizards"
                  parent="effective_management.effective_sale"
                  sequence="4"
        />
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_project_efficiency_detail_tree" model="ir.ui.view">
            <field name="name">group_project_efficiency_detail_tree</field>
            <field name="model">group.project.efficiency.detail</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <tree create="false" edit="false" delete="false" class="hide_o_list_record_selector">
                    <field name="order_id"/>
<!--                    <field name="so_name"/>-->
                    <field name="partner_name"/>
                    <field name="project_name"/>
                    <field name="key_account"/>
                    <field name="solution_maker"/>
                    <field name="project_type"/>
                    <field name="end_month"/>
                    <field name="revenue_received" widget="integer"/>
                    <field name="payment_no_invoice" widget="integer"/>
                    <field name="actual_labor" widget="integer"/>
                    <field name="actual_materials_and_other_costs" widget="integer"/>
                    <field name="total_depreciation_cost" widget="integer"/>
                    <field name="iv_fee" widget="integer"/>
                    <field name="overhead_cost_amount" widget="integer"/>
                    <field name="total_cost" widget="integer"/>
                    <field name="invoice_processing_profit" widget="integer"/>
                    <field name="no_invoice_extra_cost" widget="integer"/>
                    <field name="efficiency" widget="integer"/>
                    <field name="input_invoice_total" widget="integer"/>
                    <field name="cit_tax_total" widget="integer"/>
                    <field name="after_tax_efficiency" widget="integer"/>
                    <field name="master_key" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="group_project_efficiency_detail_search" model="ir.ui.view">
            <field name="name">group_project_efficiency_detail_search</field>
            <field name="model">group.project.efficiency.detail</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search>
                    <field name="order_id" string="Mã báo giá" filter_domain="[('order_id.name', 'ilike', self)]"/>
                    <field name="partner_name" string="Khách hàng" filter_domain="[('partner_name', 'ilike', self)]"/>
                    <field name="key_account" string="Key Account" filter_domain="[('key_account', 'ilike', self)]"/>
                    <field name="solution_maker" string="Solution Maker" filter_domain="[('solution_maker', 'ilike', self)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_key_account" string="Key Account" context="{'group_by': 'key_account'}"/>
                        <filter name="group_by_solution_maker" string="Solution Maker" context="{'group_by': 'solution_maker'}"/>
                        <filter name="group_by_project_type" string="Phân loại" context="{'group_by': 'project_type'}"/>
                        <filter name="group_by_end_month" string="Tháng kết thúc" context="{'group_by': 'end_month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_group_project_efficiency_detail" model="ir.actions.act_window">
            <field name="name">Báo cáo hiệu quả dự án chung</field>
            <field name="res_model">group.project.efficiency.detail</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="group_project_efficiency_detail_tree"/>
            <field name="search_view_id" ref="group_project_efficiency_detail_search"/>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Không có dữ liệu báo cáo hiệu quả dự án chung
                </p>
                <p>
                    Sử dụng wizard để tạo báo cáo hiệu quả dự án chung theo năm.
                </p>
            </field>
        </record>
    </data>
</odoo>

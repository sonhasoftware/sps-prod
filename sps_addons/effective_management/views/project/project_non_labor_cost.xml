<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="project_non_labor_cost_search_view">
            <field name="name">project_non_labor_cost_search_view</field>
            <field name="model">project.non.labor.cost</field>
            <field name="arch" type="xml">
                <search>
                    <field name="project_code"/>
                    <field name="project_name"/>
                    <field name="date_close"/>
                    <field name="result"/>
                </search>
            </field>
        </record>

        <record id="project_non_labor_cost_tree" model="ir.ui.view">
            <field name="name">project_non_labor_cost_tree_view</field>
            <field name="model">project.non.labor.cost</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <tree create="false" edit="false" delete="false" class="hide_o_list_record_selector" >
                    <field name="project_code"/>
                    <field name="project_name"/>
                    <field name="date_close"/>
                    <field name="budget" widget="integer"/>
                    <field name="expenses" widget="integer"/>
                    <field name="expenses_company" widget="integer"/>
                    <field name="dif" widget="integer"/>
                    <field name="result"/>
                    <field name="master_key" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="action_project_non_labor_cost_view" model="ir.actions.act_window">
            <field name="name">Báo cáo tình trạng giao hàng</field>
            <field name="res_model">project.non.labor.cost</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree</field>
        </record>

    </data>
</odoo>

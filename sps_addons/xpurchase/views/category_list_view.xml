<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--phân loại nhà cung cấp-->
        <record id="action_category_list_tree" model="ir.ui.view">
            <field name="name">Phân loại NCC</field>
            <field name="model">category.supplier</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="action_category_list" model="ir.actions.act_window">
            <field name="name">Phân loại NCC</field>
            <field name="res_model">category.supplier</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
        </record>

        <menuitem
                id="CA_menu_list"
                name="Phân loại NCC"
                action="action_category_list"
                parent="purchase.menu_purchase_config"
                sequence="15"/>


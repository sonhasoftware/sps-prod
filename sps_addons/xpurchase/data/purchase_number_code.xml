<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="seq_purchase_batch" model="ir.sequence">
            <field name="name">Batch Transfer</field>
            <field name="code">purchase.requisition</field>
            <field name="prefix">PA</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="cron_state_out_date" model="ir.cron">
            <field name="name">Puchase: state out date</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="doall">False</field>
            <field name="active">True</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_state_out_date()</field>
        </record>
        <record id="cron_state_done_purchase_requisiton" model="ir.cron">
            <field name="name">Puchase Requisiton: state done</field>
            <field name="active">True</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="doall">False</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="model_id" ref="purchase_requisition.model_purchase_requisition"/>
            <field name="nextcall" eval="datetime.now(pytz.timezone('UTC')).strftime('%Y-%m-%d 17:10:00')" />
            <field name="state">code</field>
            <field name="code">model.check_x_state()</field>
        </record>
        <record id="cron_state_done_purchase_requisiton1" model="ir.cron">
            <field name="name">Puchase Requisiton: state going</field>
            <field name="active">True</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="doall">False</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="datetime.now(pytz.timezone('UTC')).strftime('%Y-%m-%d 17:10:00')" />
            <field name="model_id" ref="purchase_requisition.model_purchase_requisition"/>
            <field name="state">code</field>
            <field name="code">model.check_x_state2()</field>
        </record>
    </data>
</odoo>
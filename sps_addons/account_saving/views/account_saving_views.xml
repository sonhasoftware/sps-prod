<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="account_saving_form_view" model="ir.ui.view">
            <field name="name">Tiền gửi tiết kiệm</field>
            <field name="model">account.saving</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"/>
                        <button string="Xác nhận" class="oe_highlight" type="object" name="action_done"
                                confirm="Xác nhận thông tin tiền gửi tiết kiệm và sinh phiếu chi?"
                                attrs="{'invisible':[('state','in',['official','settled'])]}"/>
                        <button string="Tất toán" class="oe_highlight" type="object" name="action_settlement"
                                attrs="{'invisible':[('state','in',['draft','settled'])]}"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="date_sent" />
                                <label for="period" string="Kì hạn" attrs="{'readonly': [('state', '=', 'official')]}"/>
                                <div>
                                    <field name="period" class="oe_inline"/>
                                    <span> / </span>
                                    <field name="date_type" class="oe_inline"/>
                                </div>
                                <field name="content"/>
                                <field name="number_contract"/>
                                <field name="user_id"/>
                                <field name="diary_id" domain="[('type', 'in', ('cash','bank'))]" attrs="{'readonly': [('state', '=', 'official')]}"/>
                                <field name="bank_id" force_save="1" attrs="{'readonly': [('state', '=', 'official')]}"/>
                                <field name="code_money" attrs="{'readonly': [('state', '=', 'official')]}"/>
                                <field name="license_type" attrs="{'readonly': [('state', '=', 'official')]}"/>
                                <field name="note"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="value_deposits" widget="monetary"
                                       options="{'currency_field': 'currency_id'}" attrs="{'readonly': [('state', '=', 'official')]}"/>
                                <field name="interest_rate"/>
                                <field name="date_settlement"/>
                                <field name="amount_settlement" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="method_settlement"/>
                                <field name="account_deposit_id" domain="[('code','=like','128%')]" attrs="{'readonly': [('state', '=', 'official')]}"/>
                                <field name="account_interest_id" domain="[('code','=like','515%')]"/>
                                <field name="payment_id"/>
                                <field name="receipts_id"/>
                                <field name="receipts_deposit_id"/>
                                <field name="renewals_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="account_saving_tree_view" model="ir.ui.view">
            <field name="name">Tiền gửi tiết kiệm</field>
            <field name="model">account.saving</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="number_contract"/>
                    <field name="date_sent"/>
                    <field name="period"/>
                    <field name="content"/>
                    <field name="bank_id"/>
                    <field name="value_deposits" string="Giá trị tiền gửi"/>
                    <field name="interest_rate"/>
                    <field name="date_settlement"/>
                    <field name="amount_settlement"/>
                    <field name="method_settlement"/>
                    <field name="note"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>
        <record id="search_account_saving" model="ir.ui.view">
            <field name="name">account.saving</field>
            <field name="model">account.saving</field>
            <field name="arch" type="xml">
                <search>
                    <field name="number_contract"/>
                    <field name="user_id"/>
                    <field name="payment_id"/>
                    <field name="receipts_id"/>
                    <field name="renewals_id"/>
                </search>
            </field>
        </record>
        <record id="action_account_saving" model="ir.actions.act_window">
            <field name="name">Tiền gửi tiết kiệm</field>
            <field name="res_model">account.saving</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
        </record>

        <record model="ir.ui.view" id="payment_view_form">
            <field name="name">Phiếu thanh toán</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_bank_id']" position="after">
                    <field name="x_origin_saving_id" invisible="1"/>
                </xpath>
            </field>
        </record>
        <menuitem
                id="menu_account_saving"
                name="Tiền gửi tiết kiệm"
                action="action_account_saving"
                parent="xaccount.menu_account_payment"
                sequence="3"/>
    </data>
</odoo>
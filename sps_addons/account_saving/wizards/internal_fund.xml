<odoo>
    <data>
        <record id="wizard_internal_fund_popup" model="ir.ui.view">
            <field name="name">Báo cáo thu chi quỹ nội bộ</field>
            <field name="model">internal.fund.popup</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Báo cáo thu chi quỹ nội bộ">
                    <group>
                        <field name="account_id"/>
                    </group>
                    <footer>
                        <button string="Xác nhận" name="action_internal_fund_popup" type="object" class="btn-primary"/>
                        <button string="Huỷ" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_internal_fund_popup" model="ir.actions.act_window">
            <field name="name">Báo cáo thu chi quỹ nội bộ</field>
            <field name="res_model">internal.fund.popup</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="domain">[]</field>
        </record>
        <menuitem action="action_internal_fund_popup"
                  name="Báo cáo thu chi quỹ nội bộ"
                  parent="account.account_reports_legal_statements_menu"
                  id="menu_internal_fund_popup"
                  sequence="25"/>
    </data>
</odoo>
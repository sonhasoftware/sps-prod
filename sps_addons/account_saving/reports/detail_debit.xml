<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="detail_debit_tree" model="ir.ui.view">
            <field name="name">Báo cáo chi tiết công nợ khách hàng / nhà cung cấp</field>
            <field name="model">detail.debit</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <tree create="false" edit="false" delete="false" class="hide_o_list_record_selector">
                    <field name="index"/>
                    <field name="date"/>
                    <field name="number"/>
                    <field name="explain"/>
<!--                    <field name="tk"/>-->
                    <field name="debt" sum="Tổng"/>
                    <field name="credit" sum="Tổng"/>
                    <field name="code"/>
                    <field name="master_key" invisible="1"/>
                    <button string="Xem chi tiết" class="btn btn-link" type="object" name="view_detail" attrs="{'invisible': [('number', 'in', [False, ''])]}"/>
                </tree>
            </field>
        </record>
        <record id="action_detail_debit" model="ir.actions.act_window">
            <field name="name">Báo cáo chi tiết công nợ khách hàng / nhà cung cấp</field>
            <field name="res_model">detail.debit</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree</field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="tndn_tax_rate_tree" model="ir.ui.view">
            <field name="name">tndn.tax.rate.tree</field>
            <field name="model">tndn.tax.rate</field>
            <field name="arch" type="xml">
                <tree string="Thuế suất TNDN" editable="bottom">
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="rate"/>
                    <field name="note"/>
                </tree>
            </field>
        </record>

        <record id="tndn_tax_rate_form" model="ir.ui.view">
            <field name="name">tndn.tax.rate.form</field>
            <field name="model">tndn.tax.rate</field>
            <field name="arch" type="xml">
                <form string="Thuế suất TNDN">
                    <sheet>
                        <group>
                            <field name="rate"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="note"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="tndn_tax_rate_action" model="ir.actions.act_window">
            <field name="name">Thuế suất TNDN</field>
            <field name="res_model">tndn.tax.rate</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Khai báo thuế suất thuế thu nhập doanh nghiệp theo từng khoảng thời gian
                </p>
                <p>
                    Mỗi mức thuế có ngày bắt đầu - ngày kết thúc; dự án sẽ áp mức theo ngày bắt đầu thực tế.
                </p>
            </field>
        </record>

        <menuitem id="menu_tndn_tax_rate"
                  name="Thuế suất TNDN"
                  action="tndn_tax_rate_action"
                  parent="account.menu_finance_configuration"
                  sequence="100"/>
    </data>
</odoo>

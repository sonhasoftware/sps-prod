<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_view_inherit123" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.sale</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                 <button name="action_view_invoice" position="before">
                    <button name="action_view_payment" type="object" class="oe_stat_button" icon="fa-money" attrs="{'invisible': [('x_payment_count', '=', 0)]}">
                        <field name="x_payment_count" widget="statinfo" string="Tạm ứng"/>
                    </button>
                </button>
                <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][2]" position="after">
                    <button name="action_invoice_custom" string="Tạo công nợ"
                        type="object" class="btn-primary"
                        attrs="{'invisible': [('invoice_status', '!=', 'to invoice')]}"/>
                    <button name="%(xaccount.action_view_sale_payment_deposit)d" string="Tạm ứng"
                        type="action" context="{'default_advance_payment_method': 'percentage'}" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                </xpath>
                <xpath expr="//group[@name='order_details']" position="inside">
                    <field name="x_invoice_frequency"
                           attrs="{'invisible': [('project_type', '=', 'service')],
                                   'required': [('project_type','in', ('maintainance','operation'))]}"/>
                    <field name="x_contract_status"/>
                    <field name="x_project_state"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='tax_id']" position="attributes">
                    <attribute name="widget">many2many_tag_once</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='tax_id']" position="attributes">
                    <attribute name="readonly">0</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']/form//field[@name='tax_id']" position="attributes">
                    <attribute name="readonly">0</attribute>
                </xpath>
                <xpath expr="//field[@name='x_expertise_ids']" position="after">
                        <field name="x_is_warranty" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                </xpath>
            </field>
        </record>
    </data>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.sale</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@id='down_payments']" position="after">
                    <div class="col-12 col-lg-6 o_setting_box" id="gen_cost">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Sản phẩm chi phí quản lý chung</span>
                            <div class="text-muted">
                                Sản phẩm được sử dụng cho việc quản lý chi phí chung trên hóa đơn
                            </div>
                            <div class="text-muted">
                                <field name="gen_cost_default_product_id" context="{'default_type': 'service'}"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
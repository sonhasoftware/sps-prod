<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="search_product_lot_filter_inherit_product_expiry" model="ir.ui.view">
        <field name="name">stock.production.lot.search.inherit</field>
        <field name="model">stock.production.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <filter string="Cảnh báo hạn kiểm định 15 ngày" name="last_15days" domain="[('expiration_date','!=',False),('expiration_date', '&lt;=', (context_today() + datetime.timedelta(days=15)).strftime('%%Y-%%m-%%d'))]"/>
                <filter string="Cảnh báo hạn kiểm định 5 ngày" name="last_5days" domain="[('expiration_date','!=',False),('expiration_date', '&lt;', (context_today() + datetime.timedelta(days=5)).strftime('%%Y-%%m-%%d'))]"/>
            </xpath>
        </field>
     </record>
    </data>
</odoo>
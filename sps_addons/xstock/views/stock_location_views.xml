<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_location_form_inherit" model="ir.ui.view">
        <field name="name">stock.location.form.inherit</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='additional_info']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='location_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='location_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='location_id']" position="after">
                <group>
                    <group>
                        <field name="x_partner_id" string="Khách hàng"/>
                        <field name="x_location" string="Địa điểm"/>
                        <field name="x_name" groups="base.group_no_one" string="Tên thay thế"/>
                        <field name="location_type" string="Location Type"/>
                    </group>
                </group>

            </xpath>
            <xpath expr="//group[@name='additional_info']" position="after">
                <group name="container_row_stock" groups="base.group_no_one" priority="6">
                    <group string="Thông tin thêm" name="additional_info_1" colspan="2">
                        <field name="usage" groups="base.group_no_one"/>
                        <field name="scrap_location" groups="base.group_no_one"/>
                        <field name="return_location" groups="base.group_no_one"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="stock.menu_action_warehouse_form" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
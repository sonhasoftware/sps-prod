<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock_supplies_report_tree" model="ir.ui.view">
            <field name="name">stock_supplies_report_tree</field>
            <field name="model">stock.supplies.rp</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <tree string="Báo cáo hiệu suất tái sử dụng vật tư" create="false" edit="false"
                      class="hide_o_list_record_selector">
                    <field name="index"/>
                    <field name="login"/>
                    <field name="name"/>
                    <field name="t1"/>
                    <field name="t2"/>
                    <field name="t3"/>
                    <field name="t4"/>
                    <field name="t5"/>
                    <field name="t6"/>
                    <field name="t7"/>
                    <field name="t8"/>
                    <field name="t9"/>
                    <field name="t10"/>
                    <field name="t11"/>
                    <field name="t12"/>
                    <field name="total"/>
                </tree>
            </field>
        </record>

        <record id="action_stock_supplies_report_view" model="ir.actions.act_window">
            <field name="name">Báo cáo hiệu suất tái sử dụng vật tư</field>
            <field name="res_model">stock.supplies.rp</field>
            <field name="view_mode">tree</field>
            <field name="context">{'has_selectors': False}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                            (0, 0, {'view_mode': 'tree', 'view_id': ref('stock_supplies_report_tree')}),
                            ]"/>
        </record>
    </data>
</odoo>

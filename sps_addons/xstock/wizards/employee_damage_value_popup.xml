<odoo>
    <data>
        <record id="wizard_employee_damage_value_popup" model="ir.ui.view">
            <field name="name">Báo cáo giá trị tổn thất CCDC</field>
            <field name="model">employee.damage.value.popup</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Báo cáo giá trị tổn thất CCDC">
                    <group>
                        <field name="year"/>
                    </group>
                    <footer>
                        <button string="Xem báo cáo" name="action_report_stock" type="object" class="btn-primary"/>
                        <button string="Huỷ" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_employee_damage_value_popup" model="ir.actions.act_window">
            <field name="name">Báo cáo giá trị tổn thất CCDC</field>
            <field name="res_model">employee.damage.value.popup</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="domain">[]</field>
        </record>
        <menuitem action="action_employee_damage_value_popup"
                  name="Báo cáo giá trị tổn thất CCDC"
                  parent="stock.menu_warehouse_report"
                  id="menu_employee_damage_value_report"
                  sequence="22"/>
    </data>
</odoo>
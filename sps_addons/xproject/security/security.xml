<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_project_wish_user" model="ir.rule">
            <field name="name">project.wish.user</field>
            <field name="model_id" ref="xproject.model_project_wish"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_project_wish_project_manager" model="ir.rule">
            <field name="name">project.wish.manager</field>
            <field name="model_id" ref="xproject.model_project_wish"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
        </record>

        <record id="group_project_accountant" model="res.groups">
            <field name="name">Kế toán dự án</field>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
            <field name="category_id" ref="base.module_category_services_project"/>
        </record>

        <record id="group_unarchive_project" model="res.groups">
            <field name="name">Bỏ lưu trữ dự án</field>
        </record>

        <record id="project.group_project_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_project_accountant'))]"/>
        </record>

        <record id="project_all_user_access" model="ir.rule">
            <field name="name">Project: all user access</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('x_member_user_ids', 'in' , [user.id])]</field>
            <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="perm_read" eval="1"/>
        </record>
        <record id="project_account_and_admin_edit_access" model="ir.rule">
            <field name="name">Project: only admin/account can edit on done/cancel</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[('state', 'in', ['completed', 'canceled'])]</field>
            <field name="groups"
                   eval="[(4, ref('project.group_project_manager')), (4 ,ref('group_project_accountant'))]"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_read" eval="1"/>
        </record>
        <record id="project_pm_edit" model="ir.rule">
            <field name="name">Project: PM can edit</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">['&amp;', ('state', 'not in', ['completed', 'canceled']), ('user_id' , '=' ,
                user.id)]
            </field>
            <field name="groups"
                   eval="[(4, ref('project.group_project_user'))]"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_read" eval="1"/>
        </record>
        <record id="project_read_not_pm" model="ir.rule">
            <field name="name">Project: readonly when not PM</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">['&amp;', ('x_member_user_ids', 'in' , [user.id]), ('user_id' , '!=' ,
                user.id)]
            </field>
            <field name="groups"
                   eval="[(4, ref('project.group_project_user'))]"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="perm_read" eval="1"/>
        </record>
        <record id="project.project_comp_rule" model="ir.rule">
            <field name="active" eval="False"/>
        </record>
        <record id="project.project_public_members_rule" model="ir.rule">
            <field name="active" eval="False"/>
        </record>
        <record id="project.project_project_rule_portal" model="ir.rule">
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>

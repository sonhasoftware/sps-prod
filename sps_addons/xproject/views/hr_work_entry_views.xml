<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_work_entry_view_form" model="ir.ui.view">
            <field name="name">hr.work.entry.form</field>
            <field name="model">hr.work.entry</field>
            <field name="inherit_id" ref="xhr_payroll.hr_work_entry_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='x_line_ids']/tree/field[@name='project_id']" position="attributes">
                    <attribute name="domain">[('state', 'in', ['planning', 'ongoing'])]</attribute>
                </xpath>
                <xpath expr="//field[@name='x_allowance_ids']/tree/field[@name='project_id']" position="attributes">
                    <attribute name="domain">[('state', 'in', ['planning', 'ongoing'])]</attribute>
                </xpath>
                <xpath expr="//field[@name='x_biz_fee_ids']/tree/field[@name='project_id']" position="attributes">
                    <attribute name="domain">[('state', 'in', ['planning', 'ongoing'])]</attribute>
                </xpath>
            </field>
        </record>

    </data>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expertise_type_tree" model="ir.ui.view">
        <field name="name">expertise.type.tree</field>
        <field name="model">expertise.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_expertise_type_search" model="ir.ui.view">
        <field name="name">expertise.type.search</field>
        <field name="model">expertise.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <group>
                    <filter string='Tình trạng hiệu lực' name="active" domain="[]" context="{'group_by': 'active'}"/>
                    <filter string='Có hiệu lực' name="active_1" domain="[('active', '=', True)]"/>
                    <filter string='Đã lưu trữ' name="active_0" domain="[('active', '=', False)]"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_expertise_type_form" model="ir.ui.view">
        <field name="name">expertise.type.form</field>
        <field name="model">expertise.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_expertise_type" model="ir.actions.act_window">
        <field name="name">Loại chuyên môn</field>
        <field name="res_model">expertise.type</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
    </record>

    <menuitem
        id="menu_expertise_type"
        name="Loại chuyên môn"
        action="action_expertise_type"
        parent="project.menu_project_config"
        sequence="100"/>


</odoo>

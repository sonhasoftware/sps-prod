<odoo>
    <data>
        <record id="wizard_manpower_weekly_report" model="ir.ui.view">
            <field name="name">Báo cáo nhân lực theo tuần</field>
            <field name="model">manpower.weekly</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Báo cáo nhân lực theo tuần">
                    <group>
                        <field name="year"/>
                        <field name="x_block_department" widget="selection"/>
                    </group>

                    <footer>
                        <button string=" Xuất báo cáo" name="print_reports" type="object" class="btn-primary"/>
                        <button string="Huỷ" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_manpower_weekly_report" model="ir.actions.act_window">
            <field name="name">Báo cáo nhân lực theo tuần</field>
            <field name="res_model">manpower.weekly</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="domain">[]</field>
        </record>
        <menuitem action="action_manpower_weekly_report"
                  name="Báo cáo nhân lực theo tuần"
                  parent="project.menu_project_report"
                  id="menu_manpower_weekly_report"
                  sequence="15"/>

    </data>
</odoo>
    <data>
        <record id="view_wizard_customer_satisfaction_form" model="ir.ui.view">
            <field name="name">wizard.customer.satisfaction.form</field>
            <field name="model">wizard.customer.satisfaction</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="year"/>
                                <field name="partner_id"/>
                            </group>
                            <group></group>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Báo cáo" name="get_report_excel" type="object" class="btn-primary"/>
                        <button string="Huỷ" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wizard_customer_satisfaction" model="ir.actions.act_window">
            <field name="name">Chỉ số hài lòng của khách hàng</field>
            <field name="res_model">wizard.customer.satisfaction</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="domain">[]</field>
        </record>


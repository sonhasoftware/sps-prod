<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="sequence_name_sale_request" model="ir.sequence">
            <field name="name">sequence_name_sale_request</field>
            <field name="code">xproject.sale_request_name</field>
            <field name="prefix"></field>
            <field name="padding">1</field>
        </record>

        <record id="cron_warning_project_process" model="ir.cron">
            <field name="name">Project: warning project process</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="doall">False</field>
            <field name="active">True</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="model_project_project"/>
            <field name="state">code</field>
            <field name="code">model.cron_warning_project_process()</field>
        </record>
        <record id="cron_done_to_invoice_project_process" model="ir.cron">
            <field name="name">Project: Done to invoice project process</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="doall">False</field>
            <field name="active">True</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="model_project_project"/>
            <field name="state">code</field>
            <field name="code">model.cron_done_to_invoice_project_process()</field>
        </record>
    </data>
</odoo>
